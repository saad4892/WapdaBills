<section class="page-intro legal-page">
    @await Html.PartialAsync("_LegalHeader", ((string)(ViewBag.CmsH1 ?? "Terms of Service"), "Legal & policy"))
</section>
@if (ViewBag.CmsBodyHtml is string body && !string.IsNullOrWhiteSpace(body))
{
    <div class="legal-prose">@Html.Raw(body)</div>
}
else
{
    @await Html.PartialAsync("_LegalSections", ViewBag.LegalFallback as IReadOnlyList<LegalSection> ?? LegalContent.Terms)
}
@await Html.PartialAsync("_LegalNav")
