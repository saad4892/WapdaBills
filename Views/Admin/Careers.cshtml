@model IReadOnlyList<JobListing>

<section class="page-intro">
    <div class="story-head">
        <div>
            <p class="eyebrow">Admin</p>
            <h1>Careers</h1>
        </div>
        <a class="btn btn-gold" href="/admin/careers/edit">New notice</a>
    </div>
</section>

<div class="admin-table">
    @foreach (var job in Model)
    {
        <div class="admin-row">
            <div>
                <strong>@job.Title</strong>
                <span>@(job.IsPublished ? "Published" : "Hidden") · @job.Organization</span>
            </div>
            <a href="/admin/careers/edit/@job.Id">Edit</a>
        </div>
    }
</div>
