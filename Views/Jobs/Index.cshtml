@model IReadOnlyList<JobListing>
@{
    ViewData["Title"] = "Electricity careers in Pakistan";
}

<section class="page-intro">
    <p class="eyebrow">Careers</p>
    <h1>Where electricity companies announce jobs</h1>
    <p>These notices explain where a distribution company publishes recruitment. They are not open vacancies, and this site does not take applications or fees.</p>
</section>

<div class="card-grid">
    @foreach (var job in Model)
    {
        <a class="story-card" href="/careers/@job.Id">
            @if (!string.IsNullOrWhiteSpace(job.ImagePath))
            {
                <img src="@job.ImagePath" alt="" />
            }
            <span class="pill">@job.EmploymentType</span>
            <strong>@job.Title</strong>
            <span>@job.Organization · @job.Location</span>
            <span>@job.Summary</span>
        </a>
    }
</div>
