@model LookupForm
@inject IConfiguration Config
@{
    var selectedCompany = DiscoCatalog.Find(Model.Company);
    if (selectedCompany is not null)
    {
        Model.Region = selectedCompany.Regions.Contains(Model.Region)
            ? Model.Region
            : selectedCompany.Regions[0];
    }

    var origin = SiteUrls.PublicOrigin(Config, Context.Request);
    var orgJson = JsonLd.Serialize(JsonLd.Organization(origin));
    var siteJson = JsonLd.Serialize(JsonLd.WebSite(origin));
    var appJson = JsonLd.Serialize(JsonLd.WebApplication(origin));
    var faqJson = JsonLd.Serialize(JsonLd.FaqPage(SiteContent.HomeFaqs));
}

<section class="hero-band on-dark" aria-labelledby="home-h1">
    <div class="hero-band__inner hero-band__grid">
        <div class="hero-copy">
            <p class="eyebrow" data-i18n="home.eyebrow">Free duplicate bill checker</p>
            <h1 id="home-h1" data-i18n="home.h1">Check Electricity Bill Online in Pakistan</h1>
            <p class="home-hero__lead" data-i18n="home.lead">
                Fast, free, live duplicate bills for LESCO, MEPCO, IESCO, K-Electric, FESCO, PESCO, GEPCO, HESCO, SEPCO, and QESCO — plus HAZECO and TESCO.
            </p>
            <ul class="hero-bullets">
                <li>
                    <svg class="hero-bullets__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M8 14.4 3.6 10l1.4-1.4 3 3 7-7L16.4 6z"/></svg>
                    <span data-i18n="home.bullet1">Free, with no login</span>
                </li>
                <li>
                    <svg class="hero-bullets__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M8 14.4 3.6 10l1.4-1.4 3 3 7-7L16.4 6z"/></svg>
                    <span data-i18n="home.bullet2">All 12 distribution companies</span>
                </li>
                <li>
                    <svg class="hero-bullets__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M8 14.4 3.6 10l1.4-1.4 3 3 7-7L16.4 6z"/></svg>
                    <span data-i18n="home.bullet3">Works on mobile</span>
                </li>
            </ul>
        </div>

        <form id="bill-form" class="bill-tool" asp-controller="Bill" asp-action="Open" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Region" id="Region" />
            <input type="hidden" name="SearchBy" id="SearchBy" value="@(Model.SearchBy == "appno" ? "appno" : "refno")" />

            @if (!string.IsNullOrWhiteSpace(Model.Error))
            {
                <div class="alert" role="alert">@Model.Error</div>
            }

            <div class="bill-tool__grid">
                <div class="bill-tool__field bill-tool__company">
                    <label class="field-label" for="Company" data-i18n="home.companyLabel">Distribution company</label>
                    <select class="bill-select" id="Company" name="Company" required
                            data-company-select
                            aria-describedby="company-help">
                        <option value="" data-i18n="home.companyPlaceholder">Select provider</option>
                        @foreach (var company in DiscoCatalog.All)
                        {
                            var isSelected = string.Equals(Model.Company, company.Code, StringComparison.OrdinalIgnoreCase);
                            if (isSelected)
                            {
                                <option value="@company.Code"
                                        data-region="@company.Regions[0]"
                                        data-pitc="@(company.UsesPitc ? "true" : "false")"
                                        data-short="@company.ShortName"
                                        selected>
                                    @company.ShortName — @SiteContent.Headquarters(company.Code)
                                </option>
                            }
                            else
                            {
                                <option value="@company.Code"
                                        data-region="@company.Regions[0]"
                                        data-pitc="@(company.UsesPitc ? "true" : "false")"
                                        data-short="@company.ShortName">
                                    @company.ShortName — @SiteContent.Headquarters(company.Code)
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="bill-tool__field bill-tool__number">
                    <div id="pitc-fields">
                        <label class="field-label" for="Number" data-i18n="home.numberLabel">Reference number or consumer ID</label>
                        <input class="number bill-number"
                               id="Number"
                               name="Number"
                               value="@Model.Number"
                               inputmode="numeric"
                               autocomplete="off"
                               maxlength="18"
                               placeholder="Enter 14-Digit Reference Number or 10-Digit Consumer ID"
                               data-i18n-placeholder="home.numberPlaceholder"
                               aria-describedby="number-help" />
                    </div>
                    <p id="ke-line" class="ke-line" hidden data-i18n="home.keLine">K-Electric uses a separate system</p>
                </div>

                <div class="bill-tool__action">
                    <span class="field-label bill-tool__action-label" aria-hidden="true">&nbsp;</span>
                    <button class="btn btn-gold bill-submit" id="open-bill" type="submit" data-i18n="home.checkBill">Check Bill</button>
                </div>

                <p class="field-hint bill-tool__company-hint" id="company-help" data-i18n="home.companyHelp">Choose the company printed on your bill.</p>

                <div class="bill-tool__advanced">
                    <button type="button"
                            class="advanced-toggle"
                            id="advanced-toggle"
                            aria-expanded="false"
                            aria-controls="advanced-panel">
                        <span data-i18n="home.advanced">Advanced Search</span>
                        <span class="advanced-toggle__icon" aria-hidden="true"></span>
                    </button>
                    <div class="advanced-panel" id="advanced-panel" hidden>
                        <div class="bill-tool__meta" id="pitc-meta">
                            <div class="ru-row" id="ru-row">
                                <span data-i18n="home.code">Code</span>
                                <label><input type="radio" name="Ru" value="" @(Model.Ru != "R" ? "checked" : "") /> U</label>
                                <label><input type="radio" name="Ru" value="R" @(Model.Ru == "R" ? "checked" : "") /> R</label>
                            </div>
                            <button type="button"
                                    class="text-link"
                                    id="ref-help-open"
                                    aria-haspopup="dialog"
                                    aria-controls="ref-help-modal"
                                    aria-describedby="number-help"
                                    data-i18n="home.refHelp">
                                Where can I find my reference number?
                            </button>
                            <span class="visually-hidden" id="number-help">Enter the 14-digit reference number or consumer ID from your bill.</span>
                        </div>
                    </div>
                </div>
            </div>

            <p class="hint bill-tool__hint" data-i18n="home.hint">Fetching a bill can take 10–20 seconds. If U does not match, R is tried automatically.</p>
        </form>
    </div>

    <svg class="hero-wave" viewBox="0 0 1440 60" preserveAspectRatio="none" height="48" aria-hidden="true">
        <path fill="#fff" d="M0 60V20C240 56 480 0 720 20s480 36 720 0v40z"></path>
    </svg>
</section>

<div class="ad-slot" aria-hidden="true"></div>

<section class="service-band why-choose" aria-labelledby="why-choose-title">
    <div class="story-head">
        <h2 id="why-choose-title" data-i18n="home.whyTitle">Why choose WAPDA BILLS</h2>
    </div>
    <div class="tool-grid">
        <article class="tool-card">
            <strong data-i18n="home.why1Title">All major DISCOs</strong>
            <span data-i18n="home.why1Body">One checker for LESCO, MEPCO, IESCO, and every other WAPDA company.</span>
        </article>
        <article class="tool-card">
            <strong data-i18n="home.why2Title">Live duplicate bills</strong>
            <span data-i18n="home.why2Body">Opens the latest available official duplicate from the upstream record.</span>
        </article>
        <article class="tool-card">
            <strong data-i18n="home.why3Title">Free and private</strong>
            <span data-i18n="home.why3Body">No payment collection; use only your reference number or consumer ID.</span>
        </article>
    </div>
</section>

<section class="disco-hub" aria-labelledby="disco-hub-title">
    <div class="story-head">
        <h2 id="disco-hub-title" data-i18n="home.discoTitle">Select Your Electricity Distribution Company (DISCO)</h2>
    </div>
    <div class="disco-hub__grid">
        @foreach (var company in DiscoCatalog.All)
        {
            var landing = SiteNav.DiscoLandings.FirstOrDefault(x => x.CompanyCode == company.Code);
            var href = landing?.Href ?? SiteNav.CheckerUrl(company.Code, company.Regions[0]);
            var city = SiteContent.Headquarters(company.Code);
            <article class="disco-card" style="--accent:@company.Color">
                <a class="disco-card__main" href="@href">
                    <span class="disco-mono" aria-hidden="true">@company.ShortName[0]</span>
                    <span class="disco-card__text">
                        <strong>@company.ShortName</strong>
                        <span>@city</span>
                    </span>
                </a>
                <a class="disco-card__check" href="@SiteNav.CheckerUrl(company.Code, company.Regions[0])#bill-form" data-i18n="home.checkBillLink">Check bill</a>
            </article>
        }
        @{
            var ajked = SiteNav.DiscoLandings.First(x => x.Href == "/ajked-bill");
        }
        <article class="disco-card" style="--accent:#0B2A5B">
            <a class="disco-card__main" href="@ajked.Href">
                <span class="disco-mono" aria-hidden="true">A</span>
                <span class="disco-card__text">
                    <strong>AJKED</strong>
                    <span>Azad Kashmir</span>
                </span>
            </a>
            <a class="disco-card__check" href="@ajked.Href" data-i18n="home.learnMore">Learn more</a>
        </article>
    </div>
</section>

<div class="ad-slot" aria-hidden="true"></div>

@await Html.PartialAsync("~/Views/Home/_HomeSections.cshtml")

@await Component.InvokeAsync("LatestContent")

<dialog class="ref-modal" id="ref-help-modal" aria-labelledby="ref-help-title">
    <div class="ref-modal__inner">
        <header class="ref-modal__head">
            <h2 id="ref-help-title" data-i18n="refHelp.title">Find your reference number</h2>
            <button type="button" class="drawer-close" id="ref-help-close" aria-label="Close" data-i18n-aria="refHelp.close">×</button>
        </header>
        <ol class="steps">
            <li><strong>14 digits</strong><span>Top left of the paper bill. Do not type the U or R letter into the number box.</span></li>
            <li><strong>U or R</strong><span>Select the letter printed after the digits. If unclear, leave U selected.</span></li>
            <li><strong>Consumer ID</strong><span>If you only have the shorter customer ID, enter those digits instead.</span></li>
        </ol>
        <div class="actions">
            <a class="btn btn-gold" href="/how-to-check-bill" data-i18n="refHelp.fullGuide">Full guide</a>
            <button type="button" class="btn btn-ghost" id="ref-help-dismiss" data-i18n="refHelp.gotIt">Got it</button>
        </div>
    </div>
</dialog>

@Html.Raw("<script type=\"application/ld+json\">")
@Html.Raw(orgJson)
@Html.Raw("</script>")
@Html.Raw("<script type=\"application/ld+json\">")
@Html.Raw(siteJson)
@Html.Raw("</script>")
@Html.Raw("<script type=\"application/ld+json\">")
@Html.Raw(appJson)
@Html.Raw("</script>")
@Html.Raw("<script type=\"application/ld+json\">")
@Html.Raw(faqJson)
@Html.Raw("</script>")
