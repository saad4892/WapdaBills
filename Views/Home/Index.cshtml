@model LookupForm
@{
    var activeRegion = DiscoCatalog.Regions.FirstOrDefault(region => region.Key == Model.Region) ?? DiscoCatalog.Regions[0];
    Model.Region = activeRegion.Key;
}

<section class="hero">
    <p class="eyebrow">11 distribution companies</p>
    <h1>Check an electricity bill</h1>
    <p>Choose a region and a company, then enter the reference number. The latest duplicate bill opens here from the official record.</p>
    <p class="hero-links"><a href="/find-number">Find number</a><a href="/resources">Resources</a><a href="/faqs">FAQs</a></p>
</section>

<form id="bill-form" class="desk" asp-controller="Bill" asp-action="Open" method="post">
    <input type="hidden" asp-for="Region" id="Region" />

    <div class="region-row" role="group" aria-label="Region">
        @foreach (var region in DiscoCatalog.Regions)
        {
            var count = DiscoCatalog.All.Count(company => company.Regions.Contains(region.Key));
            <button type="button"
                    class="region-btn @(Model.Region == region.Key ? "is-on" : "")"
                    data-region-btn="@region.Key"
                    aria-pressed="@(Model.Region == region.Key ? "true" : "false")">
                <span>@region.Label</span>
                <small>@count</small>
            </button>
        }
    </div>
    <p class="region-detail" id="region-detail">
        @(DiscoCatalog.Regions.First(region => region.Key == Model.Region).Detail)
    </p>

    @foreach (var region in DiscoCatalog.Regions)
    {
        <section class="region-block @(Model.Region == region.Key ? "" : "is-out")" data-region-panel="@region.Key" data-detail="@region.Detail">
            <div class="company-grid">
                @foreach (var company in DiscoCatalog.All.Where(company => company.Regions.Contains(region.Key)))
                {
                    var selected = Model.Company == company.Code && Model.Region == region.Key;
                    <label class="company-card" style="--accent:@company.Color">
                        <input type="radio" name="Company" value="@company.Code" @(selected ? "checked" : "") data-pitc="@(company.UsesPitc ? "true" : "false")" data-short="@company.ShortName" data-name="@company.FullName" />
                        <span class="company-top">
                            <span class="company-code">@company.ShortName</span>
                            <span class="pill">@(company.UsesPitc ? "PITC" : "Separate portal")</span>
                        </span>
                        <span class="company-name">@company.FullName</span>
                        <span class="company-coverage">@company.Coverage</span>
                    </label>
                }
            </div>
        </section>
    }

    <section class="lookup" id="lookup-panel">
        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="alert" role="alert">@Model.Error</div>
        }

        <div id="ke-note" class="ke-note" hidden>
            <h2>K-Electric uses a separate system</h2>
            <p>Karachi bills are not on the WAPDA or PITC portal. Use the 13-digit account number on the official K-Electric site.</p>
            <a class="btn btn-dark" href="https://ke.com.pk/bills-e-payments/" target="_blank" rel="noopener">Open K-Electric bills</a>
        </div>

        <div id="pitc-fields">
            <div class="lookup-head">
                <h2 id="selected-company">Reference number</h2>
                <p>The 14-digit reference number is at the top left of the bill, followed by U or R.</p>
            </div>

            <div class="search-by">
                <label><input type="radio" name="SearchBy" value="refno" @(Model.SearchBy != "appno" ? "checked" : "") /> Reference number</label>
                <label><input type="radio" name="SearchBy" value="appno" @(Model.SearchBy == "appno" ? "checked" : "") /> Customer ID</label>
            </div>

            <label class="field-label" for="Number">Number</label>
            <input class="number" id="Number" name="Number" value="@Model.Number" inputmode="numeric" autocomplete="off" maxlength="18" placeholder="14 digit reference number" />

            <div class="ru-row" id="ru-row">
                <span>Code</span>
                <label><input type="radio" name="Ru" value="" @(Model.Ru != "R" ? "checked" : "") /> U</label>
                <label><input type="radio" name="Ru" value="R" @(Model.Ru == "R" ? "checked" : "") /> R</label>
            </div>

            <button class="btn btn-gold" id="open-bill" type="submit">Open bill</button>
            <p class="hint">Fetching a bill can take 10–20 seconds. If U does not match, R is tried automatically.</p>
        </div>
    </section>
</form>

@await Html.PartialAsync("_ServiceSections")

@await Component.InvokeAsync("LatestContent")
