@{
    var code = ViewData["StatusCode"] as int? ?? 404;
}
<section class="page-intro">
    <p class="eyebrow">Error @code</p>
    <h1>@(code == 404 ? "Page not found" : "Something went wrong")</h1>
    <p>
        @(code == 404
            ? "That URL is not on this site. Use the bill checker or browse DISCO pages from the menu."
            : "Please try again in a moment.")
    </p>
    <div class="actions">
        <a class="btn btn-gold" href="/">Check electricity bill</a>
        <a class="btn btn-ghost" href="/guides">Browse guides</a>
    </div>
</section>
